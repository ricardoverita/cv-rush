{
  "name": "cv-rush",
  "private": true,
  "description": "Open-source 2D browser game about the hiring process: the entry point to a developer network.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.11.2 <13"
  },
  "scripts": {
    "postinstall": "pnpm build:packages && pnpm --filter @cv-rush/api db:generate",
    "dev": "pnpm build:packages && pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @cv-rush/api test:integration",
    "test:e2e": "pnpm --filter @cv-rush/web test:e2e",
    "db:migrate": "pnpm --filter @cv-rush/api db:migrate",
    "db:migrate:dev": "pnpm --filter @cv-rush/api db:migrate:dev",
    "db:seed": "pnpm --filter @cv-rush/api db:seed",
    "db:studio": "pnpm --filter @cv-rush/api db:studio",
    "db:check": "pnpm --filter @cv-rush/api db:check",
    "content:validate": "pnpm --filter @cv-rush/content validate:catalog",
    "questions:validate": "pnpm --filter @cv-rush/content validate:questions",
    "translations:validate": "pnpm --filter @cv-rush/i18n validate",
    "docs:check": "node tools/check-doc-links.mjs",
    "audit:check": "node tools/check-audit.mjs",
    "validate": "pnpm content:validate && pnpm questions:validate && pnpm translations:validate && pnpm docs:check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
