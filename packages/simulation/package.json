{
  "name": "@cv-rush/simulation",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic logic shared by the API (authoritative) and the game (rendering). No I/O, no secrets, no dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cv-rush/config": "workspace:*"
  }
}
