{
  "name": "@cv-rush/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "UI message catalogs (en, es) and translation validation. English is the fallback locale.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*": "./messages/*"
  },
  "files": [
    "dist",
    "messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli/validate.ts"
  },
  "dependencies": {
    "@cv-rush/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cv-rush/config": "workspace:*"
  }
}
