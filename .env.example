# CV Rush — environment variables.
# Local development works WITHOUT a .env file: the defaults below match compose.yaml.
# Copy this file to .env only to override something. Never commit real secrets.

# --- Runtime
NODE_ENV=development
LOG_LEVEL=info

# --- API (apps/api)
API_HOST=0.0.0.0
API_PORT=4000

# --- Web (apps/web)
# Public origin of the site (canonical URLs, hreflang, OpenGraph)
PUBLIC_BASE_URL=http://localhost:3000
# Where the web server reaches the API (also used by the dev /api rewrite)
API_INTERNAL_URL=http://localhost:4000

# --- PostgreSQL and Redis (compose.yaml)
DATABASE_URL=postgresql://cvrush:cvrush@localhost:5432/cvrush
REDIS_URL=redis://localhost:6379

# --- Question generation (provider-agnostic, ADR-018). Only "fake" exists today; it needs no API key.
QUESTION_GENERATION_PROVIDER=fake
QUESTION_VERIFICATION_PROVIDER=fake
