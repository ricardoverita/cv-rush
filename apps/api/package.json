{
  "name": "@cv-rush/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular monolith: HTTP API entrypoint and worker entrypoint.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "pnpm db:generate && tsc -p tsconfig.build.json && pnpm run \"/^dev:(build|http|worker)$/\"",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:http": "node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.http.js",
    "dev:worker": "node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.worker.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.http.js",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.worker.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@cv-rush/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.12",
    "fastify": "5.11.3",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cv-rush/config": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "unplugin-swc": "2.0.0"
  }
}
